# Hardik LLM Lab - Documentation Dockerfile
# Build: docker build -f Dockerfile.docs -t hardik-llm-docs .
# Run: docker run -p 8000:8000 -v $(pwd):/docs hardik-llm-docs

FROM python:3.11-slim

WORKDIR /docs

# Install system deps for building
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY . .

# Install package in development mode
RUN pip install --upgrade pip && \
    pip install -e ".[dev]"

# Expose MkDocs port
EXPOSE 8000

# Default command: serve with live reload on all interfaces
CMD ["mkdocs", "serve", "--dev-addr=0.0.0.0:8000"]